<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Isolate this repository from machine-level feeds so restores are reproducible
    on any machine and in CI. Central package management also requires either a
    single source or explicit package source mapping (NU1507).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
