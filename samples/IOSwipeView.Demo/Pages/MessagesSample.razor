@page "/samples/messages"

<PageTitle>Messages — IOSwipeView</PageTitle>

<PageHeader Eyebrow="Sample"
            Title="Messages &amp; notifications"
            Subtitle="Two surfaces with very different geometry: a flush conversation list, and floating notification pills over a wallpaper." />

<div class="grid lg:grid-cols-2 gap-6 items-start">
    <PhoneFrame Title="Messages" BackLabel="Edit">
        <SwipeList TItem="Chat"
                   Items="@_chats"
                   ListOptions="SwipeListOptions.ClassicList with { DividerInset = 64 }"
                   OnItemDeleted="OnChatDeleted">
            <LeadingActions Context="ctx">
                <SwipeAction Background="#007aff" Foreground="white" OnInvoked="() => Pin(ctx.Item)">
                    @(ctx.Item.Pinned ? "Unpin" : "Pin")
                </SwipeAction>
            </LeadingActions>
            <ItemTemplate Context="chat">
                <ListRow Glyph="@chat.Initials" GlyphColor="@chat.Color" Title="@chat.Name"
                         Preview="@chat.Message" Meta="@chat.Time" Unread="chat.Unread" />
            </ItemTemplate>
            <TrailingActions Context="ctx">
                <SwipeAction Background="#5856d6" Foreground="white" OnInvoked="() => Mute(ctx.Item)">
                    @(ctx.Item.Muted ? "Unmute" : "Mute")
                </SwipeAction>
                <SwipeAction Background="#ff3b30" Foreground="white" TriggerStage="1"
                             OnInvoked="() => ctx.DeleteAsync()">Delete</SwipeAction>
            </TrailingActions>
            <EmptyContent>
                <div class="text-center py-16">
                    <p class="text-subheadline text-label-secondary">No conversations</p>
                    <button type="button" class="btn-ghost mt-3 text-footnote" @onclick="ResetChats">Restore messages</button>
                </div>
            </EmptyContent>
        </SwipeList>
    </PhoneFrame>

    <div class="space-y-4">
        <div class="relative rounded-ios-device bg-[#2c2c2e] dark:bg-[#1a1a1c] p-[9px] shadow-[0_25px_60px_-15px_rgba(0,0,0,0.7),0_0_0_1px_rgba(0,0,0,0.3)] dark:shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9),0_0_0_1px_rgba(255,255,255,0.15)] ring-1 ring-black/30 dark:ring-white/15 border border-white/10 dark:border-white/10">
            <div class="rounded-[42px] overflow-hidden p-4 pt-14 pb-10 flex flex-col h-[700px] max-h-[85vh] border border-separator/30"
                 style="background:linear-gradient(160deg,#1c1c3a 0%,#3b2b5c 45%,#7b3f61 100%)">
                <div class="text-center text-white mb-6 flex-shrink-0">
                    <p class="text-6xl font-light tracking-tight">9:41</p>
                    <p class="text-callout opacity-80">Tuesday, 16 August</p>
                </div>

                <div class="flex-1 overflow-y-auto min-h-0 space-y-2.5">
                    <SwipeList TItem="NotificationItem"
                               Items="@_notifications"
                               ListOptions="SwipeListOptions.Notification with { DeleteAnimation = SwipeListAnimation.PopOut }"
                               OnItemDeleted="OnNotificationCleared">
                        <ItemTemplate Context="note">
                            <div class="rounded-ios-lg p-3 select-none mb-2"
                                 style="background:rgb(255 255 255 / 0.16);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)">
                                <div class="flex items-center gap-2 text-white/70 text-caption1 mb-0.5">
                                    <span class="grid place-items-center w-4 h-4 rounded-[4px] text-[9px]" style="background:@note.Color">@note.Badge</span>
                                    <span>@note.App</span>
                                    <span class="ml-auto">@note.Time</span>
                                </div>
                                <p class="text-white text-subheadline font-semibold">@note.Title</p>
                                <p class="text-white/80 text-subheadline">@note.Body</p>
                            </div>
                        </ItemTemplate>
                        <TrailingActions Context="ctx">
                            <SwipeAction Background="rgb(255 255 255 / 0.22)" Foreground="white">Options</SwipeAction>
                            <SwipeAction Background="#ff3b30" Foreground="white" TriggerStage="1"
                                         OnInvoked="() => ctx.DeleteAsync()">Clear</SwipeAction>
                        </TrailingActions>
                        <EmptyContent>
                            <div class="text-center py-10">
                                <p class="text-white/70 text-subheadline">No notifications</p>
                                <button type="button" class="btn-ghost text-white mt-3" @onclick="ResetNotifications">Restore</button>
                            </div>
                        </EmptyContent>
                    </SwipeList>
                </div>
            </div>
        </div>

        <Panel Title="Why two presets">
            <p class="text-subheadline text-label-secondary">
                The conversation list uses <code class="font-mono text-footnote">ClassicList</code> — flush, square, edge to edge.
                The lock screen uses <code class="font-mono text-footnote">Notification</code> — 16px pills with 6px spacing so the
                actions read as separate floating objects over the wallpaper. Both powered by <code class="font-mono text-footnote">SwipeList&lt;TItem&gt;</code>.
            </p>
        </Panel>
    </div>
</div>

@code {
    private sealed class Chat
    {
        public required string Initials { get; init; }
        public required string Color { get; init; }
        public required string Name { get; init; }
        public required string Message { get; init; }
        public required string Time { get; init; }
        public bool Unread { get; set; }
        public bool Pinned { get; set; }
        public bool Muted { get; set; }
    }

    private sealed class NotificationItem
    {
        public required string App { get; init; }
        public required string Badge { get; init; }
        public required string Color { get; init; }
        public required string Title { get; init; }
        public required string Body { get; init; }
        public required string Time { get; init; }
    }

    private List<Chat> _chats = [];
    private List<NotificationItem> _notifications = [];

    protected override void OnInitialized()
    {
        ResetChats();
        ResetNotifications();
    }

    private void ResetChats()
    {
        _chats =
        [
            new() { Initials = "AL", Color = "var(--sys-pink)", Name = "Ada Lovelace", Message = "The analytical engine weaves algebraical patterns...", Time = "09:41", Unread = true },
            new() { Initials = "GH", Color = "var(--sys-teal)", Name = "Grace Hopper", Message = "First actual case of bug being found.", Time = "08:12", Unread = true, Pinned = true },
            new() { Initials = "AT", Color = "var(--sys-orange)", Name = "Alan Turing", Message = "Can machines think?", Time = "Yesterday", Unread = false },
            new() { Initials = "KJ", Color = "var(--sys-purple)", Name = "Katherine Johnson", Message = "Orbital flight coordinates verified.", Time = "Tuesday", Unread = false },
            new() { Initials = "CS", Color = "var(--sys-blue)", Name = "Claude Shannon", Message = "The fundamental problem of communication...", Time = "Monday", Unread = false },
        ];
    }

    private void ResetNotifications()
    {
        _notifications =
        [
            new() { App = "Messages", Badge = "💬", Color = "var(--sys-green)", Title = "Ada Lovelace", Body = "The analytical engine is ready for testing.", Time = "2m ago" },
            new() { App = "Calendar", Badge = "📅", Color = "var(--sys-red)", Title = "Team Standup", Body = "Starting in 10 minutes (Room B)", Time = "10m ago" },
            new() { App = "Reminders", Badge = "📋", Color = "var(--sys-orange)", Title = "Deploy IOSwipeView v1.0", Body = "Review package manifest and push to NuGet", Time = "1h ago" },
        ];
    }

    private void Pin(Chat chat) => chat.Pinned = !chat.Pinned;
    private void Mute(Chat chat) => chat.Muted = !chat.Muted;
    private void OnChatDeleted(Chat chat) => _chats.Remove(chat);
    private void OnNotificationCleared(NotificationItem note) => _notifications.Remove(note);
}
