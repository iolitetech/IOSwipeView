@page "/samples/rtl"

<PageTitle>RTL &amp; Kurdish — IOSwipeView</PageTitle>

<PageHeader Eyebrow="Sample"
            Title="Right-to-Left (RTL) &amp; Kurdish"
            Subtitle="IOSwipeView natively uses CSS logical properties (inset-inline-start/end). When the container or document is in RTL, leading and trailing actions mirror automatically." />

<!-- Direction Toggle Bar -->
<div class="mb-6 p-4 bg-grouped-secondary rounded-ios-lg border border-separator/60 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
        <span class="text-callout text-label font-medium">Layout Direction:</span>
        <div class="segmented-nav">
            <button type="button" class="nav-tab @(_isRtl ? "" : "nav-tab-active")" @onclick="() => SetRtl(false)">
                English (LTR)
            </button>
            <button type="button" class="nav-tab @(_isRtl ? "nav-tab-active" : "")" @onclick="() => SetRtl(true)">
                Kurdish (RTL)
            </button>
        </div>
    </div>
    <span class="text-footnote text-label-secondary">
        Current: <code class="font-mono text-sys-blue">dir="@(_isRtl ? "rtl" : "ltr")"</code>
    </span>
</div>

<div class="grid lg:grid-cols-[minmax(0,1fr)_320px] gap-6 items-start" dir="@(_isRtl ? "rtl" : "ltr")">
    <PhoneFrame Title="@(_isRtl ? "سندووقی هاتوو" : "Inbox")" BackLabel="@(_isRtl ? "نامەدانەکان" : "Mailboxes")">
        <SwipeList @key="_isRtl"
                   TItem="MailItem"
                   Items="@_items"
                   ListOptions="SwipeListOptions.ClassicList with { DividerInset = 54 }"
                   OnItemDeleted="OnItemDeleted">
            <LeadingActions Context="ctx">
                <SwipeAction Background="#007aff" Foreground="white" Placement="ActionPlacement.Top"
                             OnInvoked="() => ToggleRead(ctx.Item)">
                    <Icon>
                        @if (ctx.Item.Unread)
                        {
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="20" height="16" x="2" y="4" rx="2"/>
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                            </svg>
                        }
                        else
                        {
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                <circle cx="12" cy="12" r="6"/>
                            </svg>
                        }
                    </Icon>
                    <ChildContent>
                        @(ctx.Item.Unread ? (_isRtl ? "خوێندراوە" : "Read") : (_isRtl ? "نەخوێندراوە" : "Unread"))
                    </ChildContent>
                </SwipeAction>
            </LeadingActions>
            <ItemTemplate Context="item">
                <ListRow Title="@(_isRtl ? item.TitleKu : item.TitleEn)"
                         Subtitle="@(_isRtl ? item.SubtitleKu : item.SubtitleEn)"
                         Preview="@(_isRtl ? item.PreviewKu : item.PreviewEn)"
                         Meta="@(_isRtl ? item.TimeKu : item.TimeEn)" Unread="item.Unread" />
            </ItemTemplate>
            <TrailingActions Context="ctx">
                <SwipeAction Background="#ff9500" Foreground="white" Placement="ActionPlacement.Top"
                             OnInvoked='() => LogAction(ctx.Item, _isRtl ? "نیشانەکرا" : "Flagged")'>
                    <Icon>
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                            <path fill-rule="evenodd" d="M3 2.25a.75.75 0 0 1 .75.75v.54l1.838-.46a9.75 9.75 0 0 1 4.725.328l.45.15a8.25 8.25 0 0 0 4.004.279l1.87-.468A.75.75 0 0 1 17.4 4.5v8.25a.75.75 0 0 1-.562.727l-1.838.46a9.75 9.75 0 0 1-4.725-.328l-.45-.15a8.25 8.25 0 0 0-4.004-.279l-1.87.468A.75.75 0 0 1 3 13.5V3A.75.75 0 0 1 3 2.25Z" clip-rule="evenodd"/>
                        </svg>
                    </Icon>
                    <ChildContent>
                        @(_isRtl ? "نیشانەکردن" : "Flag")
                    </ChildContent>
                </SwipeAction>
                <SwipeAction Background="#34c759" Foreground="white" Placement="ActionPlacement.Top" TriggerStage="1"
                             OnInvoked='() => LogAction(ctx.Item, _isRtl ? "ئەرشیڤکرا (قۆناغی ١)" : "Archived (Stage 1)")'>
                    <Icon>
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="5" x="2" y="3" rx="1"/>
                            <path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/>
                            <path d="M10 12h4"/>
                        </svg>
                    </Icon>
                    <ChildContent>
                        @(_isRtl ? "ئەرشیڤ" : "Archive")
                    </ChildContent>
                </SwipeAction>
                <SwipeAction Background="#ff3b30" Foreground="white" Placement="ActionPlacement.Top" TriggerStage="2"
                             OnInvoked="() => ctx.DeleteAsync()">
                    <Icon>
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 6h18"/>
                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                            <line x1="10" x2="10" y1="11" y2="17"/>
                            <line x1="14" x2="14" y1="11" y2="17"/>
                        </svg>
                    </Icon>
                    <ChildContent>
                        @(_isRtl ? "سڕینەوە" : "Delete")
                    </ChildContent>
                </SwipeAction>
            </TrailingActions>
            <EmptyContent>
                <div class="px-4 py-16 text-center">
                    <p class="text-body text-label-secondary">@(_isRtl ? "سندووقی هاتوو بەتاڵە" : "Inbox zero")</p>
                    <button type="button" class="btn-ghost mt-3" @onclick="Reset">@(_isRtl ? "گەڕاندنەوەی نامەکان" : "Restore messages")</button>
                </div>
            </EmptyContent>
        </SwipeList>
    </PhoneFrame>

    <div class="space-y-4" dir="ltr">
        <Panel Title="What this shows">
            <ul class="space-y-2.5 text-subheadline text-label-secondary">
                <li><span class="text-label font-medium">Native Kurdish Support.</span> Full bidirectional mirror for Sorani Kurdish and RTL layouts.</li>
                <li><span class="text-label font-medium">Automatic Mirroring.</span> Under RTL, <code class="font-mono text-footnote">Leading</code> actions render on the <strong>right</strong> side, and <code class="font-mono text-footnote">Trailing</code> actions render on the <strong>left</strong>.</li>
                <li><span class="text-label font-medium">Multi-Stage in RTL.</span> Dragging leftwards triggers progressive Archive (Stage 1) and Delete (Stage 2) smoothly.</li>
            </ul>
        </Panel>

        <Panel Title="Activity">
            <Trailing>
                <button type="button" class="text-footnote text-sys-blue" @onclick="Reset">Reset</button>
            </Trailing>
            <ChildContent>
                <ul class="font-mono text-caption1 space-y-1 h-40 overflow-y-auto">
                    @if (_log.Count == 0)
                    {
                        <li class="text-label-tertiary">Swipe an item…</li>
                    }
                    @foreach (var entry in _log)
                    {
                        <li class="text-label-secondary">@entry</li>
                    }
                </ul>
            </ChildContent>
        </Panel>
    </div>
</div>

@code {
    private bool _isRtl = true;

    private sealed class MailItem
    {
        public required string TitleEn { get; init; }
        public required string TitleKu { get; init; }
        public required string SubtitleEn { get; init; }
        public required string SubtitleKu { get; init; }
        public required string PreviewEn { get; init; }
        public required string PreviewKu { get; init; }
        public required string TimeEn { get; init; }
        public required string TimeKu { get; init; }
        public bool Unread { get; set; }
    }

    private List<MailItem> _items = [];
    private readonly List<string> _log = [];

    protected override void OnInitialized() => Reset();

    private void SetRtl(bool isRtl)
    {
        _isRtl = isRtl;
        StateHasChanged();
    }

    private void Reset()
    {
        _items =
        [
            new()
            {
                TitleEn = "Apple Developer",
                TitleKu = "گەشەپێدەری ئەپڵ",
                SubtitleEn = "Your app submission was approved",
                SubtitleKu = "ئەپەکەت لە ئەپ ستۆر پەسەند کرا",
                PreviewEn = "IOSwipeView 1.0 is now ready for distribution on the App Store.",
                PreviewKu = "وەشانی نوێی IOSwipeView ئامادەیە بۆ بەکارهێنان لەسەر ئەپ ستۆر.",
                TimeEn = "10:30",
                TimeKu = "١٠:٣٠",
                Unread = true,
            },
            new()
            {
                TitleEn = "GitHub Notifications",
                TitleKu = "ئاگادارییەکانی گیت هاب",
                SubtitleEn = "PR #42 merged into master",
                SubtitleKu = "داواکاری یەکخستن #٤٢ بە سەرکەوتوویی پەسەند کرا",
                PreviewEn = "All 42 tests passed on .NET 10.0 runtime with zero errors.",
                PreviewKu = "هەموو ٤٢ تاقیکردنەوەکە بە سەرکەوتوویی لەسەر دۆتی نێت ١٠ تێپەڕین.",
                TimeEn = "09:15",
                TimeKu = "٠٩:١٥",
                Unread = true,
            },
            new()
            {
                TitleEn = "Design Weekly",
                TitleKu = "دیزاینی هەفتانە",
                SubtitleEn = "Typography & Fluid Gestures",
                SubtitleKu = "تایپۆگرافی و جووڵەی نەرم لە وێبدا",
                PreviewEn = "Tips on building responsive mobile-first interfaces with natural spring curves.",
                PreviewKu = "ڕێنمایی نوێ بۆ دروستکردنی ئەزموونی مۆبایل بە جووڵەی نەرم و خێرا.",
                TimeEn = "Yesterday",
                TimeKu = "دوێنێ",
                Unread = false,
            },
        ];
        _log.Clear();
    }

    private void ToggleRead(MailItem item)
    {
        item.Unread = !item.Unread;
        _log.Insert(0, $"{DateTime.Now:HH:mm:ss} — {(_isRtl ? "گۆڕینی دۆخی خوێندنەوە بۆ" : "Toggled read state for")} '{(_isRtl ? item.TitleKu : item.TitleEn)}'");
    }

    private void LogAction(MailItem item, string action)
    {
        _log.Insert(0, $"{DateTime.Now:HH:mm:ss} — {action} لەسەر '{(_isRtl ? item.TitleKu : item.TitleEn)}'");
    }

    private void OnItemDeleted(MailItem item)
    {
        _items.Remove(item);
        _log.Insert(0, $"{DateTime.Now:HH:mm:ss} — {(_isRtl ? "سڕایەوە" : "Deleted")} '{(_isRtl ? item.TitleKu : item.TitleEn)}'");
    }
}
