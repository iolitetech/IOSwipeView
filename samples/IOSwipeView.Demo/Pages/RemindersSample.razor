@page "/samples/reminders"

<PageTitle>Reminders — IOSwipeView</PageTitle>

<PageHeader Eyebrow="Sample"
            Title="Reminders"
            Subtitle="Inset grouped lists, where the section has rounded corners but the actions inside stay flush — and completing a task removes it with a spring." />

<div class="grid lg:grid-cols-[minmax(0,1fr)_320px] gap-6 items-start">
    <PhoneFrame Title="Today" BackLabel="Lists">
        <div class="px-3 pb-4 pt-2 space-y-5">
            @foreach (var list in _lists)
            {
                <div>
                    <div class="flex items-center gap-2 px-2 pb-1.5">
                        <span class="w-2.5 h-2.5 rounded-full" style="background:@list.Color"></span>
                        <h3 class="text-footnote font-semibold uppercase tracking-wide text-label-secondary">@list.Name</h3>
                        <span class="ml-auto text-footnote text-label-tertiary">@list.Tasks.Count</span>
                    </div>

                    <div class="rounded-ios-card overflow-hidden divide-y divide-separator/60">
                        <SwipeViewGroup>
                            @foreach (var task in list.Tasks)
                            {
                                <SwipeView Options="SwipeOptions.InsetGrouped">
                                    <LeadingActions>
                                        <SwipeAction Background="#34c759" Foreground="white" AllowSwipeToTrigger
                                                     OnInvoked="() => Complete(list, task)">Done</SwipeAction>
                                    </LeadingActions>
                                    <ChildContent>
                                        <div class="flex items-start gap-3 bg-grouped-secondary px-4 py-3 select-none">
                                            <span class="mt-0.5 w-[22px] h-[22px] shrink-0 rounded-full border-2 border-label-tertiary"></span>
                                            <div class="min-w-0 flex-1">
                                                <p class="text-body text-label">@task.Title</p>
                                                @if (!string.IsNullOrWhiteSpace(task.Note))
                                                {
                                                    <p class="text-subheadline text-label-secondary">@task.Note</p>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(task.Due))
                                                {
                                                    <p class="text-footnote mt-0.5" style="color:@(task.Overdue ? "var(--sys-red)" : "var(--sys-label-secondary)")">@task.Due</p>
                                                }
                                            </div>
                                            @if (task.Flagged)
                                            {
                                                <span class="text-sys-orange">⚑</span>
                                            }
                                        </div>
                                    </ChildContent>
                                    <TrailingActions>
                                        <SwipeAction Background="#ff9500" Foreground="white" OnInvoked="() => Flag(task)">Flag</SwipeAction>
                                        <SwipeAction Background="#ff3b30" Foreground="white" AllowSwipeToTrigger
                                                     OnInvoked="() => Delete(list, task)">Delete</SwipeAction>
                                    </TrailingActions>
                                </SwipeView>
                            }
                        </SwipeViewGroup>

                        @if (list.Tasks.Count == 0)
                        {
                            <div class="bg-grouped-secondary px-4 py-8 text-center">
                                <p class="text-subheadline text-label-secondary">All caught up</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </PhoneFrame>

    <div class="space-y-4">
        <Panel Title="Inset grouped geometry">
            <p class="text-subheadline text-label-secondary">
                <code class="font-mono text-footnote">SwipeOptions.InsetGrouped</code> sets a 12px mask radius with 0 action
                radius and 0 spacing. The revealed strip is clipped by the rounded section, so actions square off against
                each other inside but follow the card's curve at the edge.
            </p>
        </Panel>

        <Panel Title="Completed">
            <Trailing>
                <button type="button" class="text-footnote text-sys-blue" @onclick="Reset">Reset</button>
            </Trailing>
            <ChildContent>
                @if (_completed.Count == 0)
                {
                    <p class="text-subheadline text-label-tertiary">Swipe a task right to complete it.</p>
                }
                <ul class="space-y-1.5">
                    @foreach (var done in _completed)
                    {
                        <li class="flex items-center gap-2 text-subheadline text-label-secondary">
                            <span class="text-sys-green">✓</span>
                            <span class="line-through">@done</span>
                        </li>
                    }
                </ul>
            </ChildContent>
        </Panel>
    </div>
</div>

@code {
    private sealed class TaskItem
    {
        public required string Title { get; init; }
        public string? Note { get; init; }
        public string? Due { get; init; }
        public bool Overdue { get; init; }
        public bool Flagged { get; set; }
    }

    private sealed class TaskList
    {
        public required string Name { get; init; }
        public required string Color { get; init; }
        public required List<TaskItem> Tasks { get; init; }
    }

    private List<TaskList> _lists = [];
    private readonly List<string> _completed = [];

    protected override void OnInitialized() => Reset();

    private void Reset()
    {
        _completed.Clear();
        _lists =
        [
            new()
            {
                Name = "IOSwipeView",
                Color = "var(--sys-blue)",
                Tasks =
                [
                    new() { Title = "Verify drag on a real device", Note = "iOS Safari and Android Chrome", Due = "Today, 09:00", Overdue = true },
                    new() { Title = "Keyboard accessibility", Note = "Open and close without a pointer" },
                    new() { Title = "RTL verification", Note = "Logical properties are in, untested", Flagged = true },
                ],
            },
            new()
            {
                Name = "Personal",
                Color = "var(--sys-orange)",
                Tasks =
                [
                    new() { Title = "Renew domain", Due = "Tomorrow" },
                    new() { Title = "Water the plants", Note = "The fern especially" },
                ],
            },
        ];
    }

    private void Complete(TaskList list, TaskItem task)
    {
        list.Tasks.Remove(task);
        _completed.Insert(0, task.Title);
    }

    private void Delete(TaskList list, TaskItem task) => list.Tasks.Remove(task);

    private void Flag(TaskItem task) => task.Flagged = !task.Flagged;
}
