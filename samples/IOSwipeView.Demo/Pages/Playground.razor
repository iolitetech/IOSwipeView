@page "/playground"

<PageTitle>Playground — IOSwipeView</PageTitle>

<PageHeader Eyebrow="Interactive"
            Title="Playground"
            Subtitle="Tune the geometry, thresholds and spring, drag the row to feel it, then copy the exact Razor that reproduces it.">
    <div class="flex flex-wrap gap-1.5">
        @foreach (var preset in PlaygroundState.Presets)
        {
            <button type="button"
                    class="@(_state.PresetId == preset.Id
                        ? "px-3 py-1.5 text-footnote font-semibold rounded-full bg-sys-blue text-white"
                        : "px-3 py-1.5 text-footnote rounded-full bg-fill-tertiary text-label-secondary hover:text-label transition-colors")"
                    title="@preset.Blurb"
                    @onclick="() => ApplyPreset(preset.Id)">
                @preset.Label
            </button>
        }
    </div>
</PageHeader>

<div class="grid lg:grid-cols-2 gap-5 items-start">
    <div class="space-y-5 lg:sticky lg:top-20">
        <Panel Title="Live preview" Subtitle="@PreviewSubtitle">
            <Trailing>
                <span class="text-caption1 font-mono px-2 py-1 rounded-full bg-fill-tertiary text-label-secondary">@_liveState</span>
            </Trailing>
            <ChildContent>
                <div class="rounded-ios-lg overflow-hidden bg-grouped p-4">
                    <SwipeView @ref="_swipe" Options="_state.Options" OnStateChanged="OnStateChanged">
                        <LeadingActions>
                            @for (var i = 0; i < _state.LeadingCount; i++)
                            {
                                var index = i;
                                <SwipeAction Background="@PlaygroundState.LeadingColors[index]"
                                             Foreground="white"
                                             ChangeLabelVisibilityOnly="_state.ChangeLabelVisibilityOnly"
                                             OnInvoked="() => LogLeading(index)">
                                    @PlaygroundState.LeadingNames[index]
                                </SwipeAction>
                            }
                        </LeadingActions>
                        <ChildContent>
                            <div class="flex items-center justify-between gap-3 bg-grouped-secondary px-4 py-5 select-none"
                                 style="border-radius:@(_state.MaskCornerRadius)px">
                                <div class="min-w-0">
                                    <p class="text-body font-semibold text-label">Swipe this row</p>
                                    <p class="text-subheadline text-label-secondary truncate">Left for @_state.TrailingCount, right for @_state.LeadingCount</p>
                                </div>
                                <span class="text-label-tertiary text-title3">⇄</span>
                            </div>
                        </ChildContent>
                        <TrailingActions>
                            @for (var i = 0; i < _state.TrailingCount; i++)
                            {
                                var index = i + (3 - _state.TrailingCount);
                                var isEdge = i == _state.TrailingCount - 1;
                                <SwipeAction Background="@PlaygroundState.TrailingColors[index]"
                                             Foreground="white"
                                             AllowSwipeToTrigger="isEdge && _state.AllowSwipeToTrigger"
                                             ChangeLabelVisibilityOnly="_state.ChangeLabelVisibilityOnly"
                                             OnInvoked="() => LogTrailing(index)">
                                    @PlaygroundState.TrailingNames[index]
                                </SwipeAction>
                            }
                        </TrailingActions>
                    </SwipeView>
                </div>

                <div class="flex flex-wrap gap-1.5 mt-4">
                    <button type="button" class="btn-ghost" @onclick="() => _swipe!.OpenAsync(SwipeSide.Leading)">Open leading</button>
                    <button type="button" class="btn-ghost" @onclick="() => _swipe!.OpenAsync(SwipeSide.Trailing)">Open trailing</button>
                    <button type="button" class="btn-ghost" @onclick="() => _swipe!.CloseAsync()">Close</button>
                    <button type="button" class="btn-danger" @onclick="() => _swipe!.TriggerAsync(SwipeSide.Trailing)">Trigger</button>
                </div>
            </ChildContent>
        </Panel>

        <Panel Title="Event log" Subtitle="Settled transitions only, never per frame">
            <Trailing>
                <button type="button" class="text-footnote text-sys-blue" @onclick="_log.Clear">Clear</button>
            </Trailing>
            <ChildContent>
                <ul class="bg-grouped-tertiary rounded-ios-lg border border-separator/60 p-3 font-mono text-caption1 space-y-1 h-40 overflow-y-auto">
                    @if (_log.Count == 0)
                    {
                        <li class="text-label-tertiary">Drag the row to stream events…</li>
                    }
                    @foreach (var entry in _log)
                    {
                        <li class="text-label-secondary">@entry</li>
                    }
                </ul>
            </ChildContent>
        </Panel>
    </div>

    <div class="space-y-5">
        <Panel Title="Layout">
            <div class="space-y-4">
                <Segmented T="SwipeActionStyle"
                           Label="Reveal style"
                           Options="_styleOptions"
                           Value="_state.Style"
                           ValueChanged="v => Set(() => _state.Style = v)" />

                <div class="grid grid-cols-2 gap-4">
                    <SliderField Label="Leading actions" Unit="" Min="0" Max="2" Value="_state.LeadingCount"
                                 ValueChanged="v => Set(() => _state.LeadingCount = (int)v)" />
                    <SliderField Label="Trailing actions" Unit="" Min="1" Max="3" Value="_state.TrailingCount"
                                 ValueChanged="v => Set(() => _state.TrailingCount = (int)v)" />
                </div>

                <div class="grid grid-cols-3 gap-4">
                    <SliderField Label="Width" Min="48" Max="160" Step="2" Value="_state.ActionWidth"
                                 ValueChanged="v => Set(() => _state.ActionWidth = v)" />
                    <SliderField Label="Spacing" Min="0" Max="24" Value="_state.Spacing"
                                 ValueChanged="v => Set(() => _state.Spacing = v)" />
                    <SliderField Label="Radius" Min="0" Max="40" Step="2" Value="_state.ActionCornerRadius"
                                 ValueChanged="v => Set(() => _state.ActionCornerRadius = v)" />
                </div>

                <SliderField Label="Mask radius" Min="0" Max="40" Step="2" Value="_state.MaskCornerRadius"
                             ValueChanged="v => Set(() => _state.MaskCornerRadius = v)" />
            </div>
        </Panel>

        <Panel Title="Reveal" Subtitle="Setting both fade points equal disables the fade entirely">
            <div class="grid grid-cols-2 gap-4">
                <SliderField Label="Fade start" Min="0" Max="120" Step="5" Value="_state.FadeStart"
                             ValueChanged="v => Set(() => _state.FadeStart = v)" />
                <SliderField Label="Fade end" Min="0" Max="160" Step="5" Value="_state.FadeEnd"
                             ValueChanged="v => Set(() => _state.FadeEnd = v)" />
            </div>
        </Panel>

        <Panel Title="Thresholds">
            <div class="space-y-4">
                <SliderField Label="Ready to expand" Min="0" Max="160" Step="5" Value="_state.ReadyToExpandPadding"
                             ValueChanged="v => Set(() => _state.ReadyToExpandPadding = v)" />
                <SliderField Label="Ready to trigger" Min="0" Max="120" Step="5" Value="_state.ReadyToTriggerPadding"
                             ValueChanged="v => Set(() => _state.ReadyToTriggerPadding = v)" />
                <SliderField Label="Minimum point to trigger" Min="0" Max="400" Step="10" Value="_state.MinimumPointToTrigger"
                             ValueChanged="v => Set(() => _state.MinimumPointToTrigger = v)" />
                <SliderField Label="Rubber banding" Unit="" Min="0.3" Max="1" Step="0.05" Value="_state.RubberBanding"
                             ValueChanged="v => Set(() => _state.RubberBanding = v)" />
            </div>
        </Panel>

        <Panel Title="Spring" Subtitle="@SpringSubtitle">
            <div class="space-y-4">
                <div class="grid grid-cols-3 sm:grid-cols-6 gap-1">
                    @foreach (var spring in PlaygroundState.Springs)
                    {
                        <button type="button"
                                class="@(_state.SpringId == spring.Id
                                    ? "py-1.5 text-caption1 font-semibold rounded-ios-sm bg-sys-blue text-white"
                                    : "py-1.5 text-caption1 rounded-ios-sm bg-fill-tertiary text-label-secondary hover:text-label transition-colors")"
                                @onclick="() => Set(() => _state.ApplySpring(spring.Id))">
                            @spring.Label
                        </button>
                    }
                </div>

                <!-- Live Spring ODE Trajectory Visualizer -->
                <div class="bg-fill-tertiary/40 border border-separator/40 rounded-ios p-3">
                    <div class="flex items-center justify-between text-caption2 font-mono text-label-secondary mb-1.5">
                        <span class="font-semibold text-label">Spring Settling Curve: x(t)</span>
                        <span>ζ = @DampingRatio.ToString("0.00") · @SpringRegime</span>
                    </div>
                    <svg viewBox="0 0 300 65" class="w-full h-16 overflow-visible">
                        <!-- Baseline (Resting Position) -->
                        <line x1="0" y1="42" x2="300" y2="42" stroke="currentColor" stroke-dasharray="3,3" class="text-separator" stroke-width="1" />
                        <line x1="0" y1="40" x2="300" y2="40" stroke="currentColor" stroke-dasharray="2,4" class="text-separator/40" stroke-width="0.5" />
                        <line x1="0" y1="44" x2="300" y2="44" stroke="currentColor" stroke-dasharray="2,4" class="text-separator/40" stroke-width="0.5" />

                        <!-- Analytical ODE Spring Curve -->
                        <path d="@SpringSvgPath" fill="none" stroke="var(--sys-blue, #007aff)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <SliderField Label="Stiffness" Unit="" Min="60" Max="600" Step="10" Value="_state.Stiffness"
                                 ValueChanged="v => Set(() => { _state.Stiffness = v; _state.MarkCustomSpring(); })" />
                    <SliderField Label="Damping" Unit="" Min="6" Max="80" Value="_state.Damping"
                                 ValueChanged="v => Set(() => { _state.Damping = v; _state.MarkCustomSpring(); })" />
                </div>
            </div>
        </Panel>

        <Panel Title="Behaviour">
            <div class="space-y-3">
                <ToggleField Label="Swipe to trigger" Hint="Edge action commits on a long drag"
                             Value="_state.AllowSwipeToTrigger" ValueChanged="v => Set(() => _state.AllowSwipeToTrigger = v)" />
                <ToggleField Label="Single swipe across" Hint="Cross from one side to the other without releasing"
                             Value="_state.AllowSingleSwipeAcross" ValueChanged="v => Set(() => _state.AllowSingleSwipeAcross = v)" />
                <ToggleField Label="Fade label only" Hint="Ramp the label instead of the whole action"
                             Value="_state.ChangeLabelVisibilityOnly" ValueChanged="v => Set(() => _state.ChangeLabelVisibilityOnly = v)" />
                <ToggleField Label="Trigger haptics" Hint="Vibrate when the edge action arms"
                             Value="_state.EnableTriggerHaptics" ValueChanged="v => Set(() => _state.EnableTriggerHaptics = v)" />
            </div>
        </Panel>

        <Panel Title="Generated Razor" BodyClass="p-4 pt-1">
            <CodeBlock Code="@_state.ToRazor()" />
        </Panel>
    </div>
</div>

@code {
    private readonly PlaygroundState _state = new();
    private readonly List<string> _log = [];
    private SwipeView? _swipe;
    private string _liveState = "Closed";

    private static readonly IReadOnlyList<Segmented<SwipeActionStyle>.Option> _styleOptions =
    [
        new(SwipeActionStyle.Mask, "Mask"),
        new(SwipeActionStyle.EqualWidths, "Equal"),
        new(SwipeActionStyle.Cascade, "Cascade"),
    ];

    private string PreviewSubtitle => $"{_state.PresetId} · {_state.Style}";

    private string SpringSubtitle => $"stiffness {_state.Stiffness:0} · damping {_state.Damping:0} · {_state.SpringId}";

    private double DampingRatio => _state.Damping / (2.0 * Math.Sqrt(Math.Max(1.0, _state.Stiffness)));

    private string SpringRegime => DampingRatio switch
    {
        < 0.99 => "Underdamped (Bouncy)",
        <= 1.01 => "Critically Damped",
        _ => "Overdamped (Smooth)"
    };

    private string SpringSvgPath
    {
        get
        {
            var k = Math.Max(1.0, _state.Stiffness);
            var c = Math.Max(0.1, _state.Damping);
            var w0 = Math.Sqrt(k);
            var zeta = c / (2.0 * w0);
            var sb = new System.Text.StringBuilder();

            const int samples = 75;
            const double totalTime = 1.0;
            const double baselineY = 42.0;
            const double initialDisplacement = 30.0; // peak start at Y=12

            for (var i = 0; i <= samples; i++)
            {
                var t = (i / (double)samples) * totalTime;
                var x = 0.0;

                if (zeta < 1.0)
                {
                    var wd = w0 * Math.Sqrt(1.0 - zeta * zeta);
                    x = Math.Exp(-zeta * w0 * t) * (Math.Cos(wd * t) + (zeta * w0 / wd) * Math.Sin(wd * t));
                }
                else if (Math.Abs(zeta - 1.0) < 0.001)
                {
                    x = Math.Exp(-w0 * t) * (1.0 + w0 * t);
                }
                else
                {
                    var gamma = w0 * Math.Sqrt(zeta * zeta - 1.0);
                    var r1 = -zeta * w0 + gamma;
                    var r2 = -zeta * w0 - gamma;
                    var c1 = r2 / (r2 - r1);
                    var c2 = 1.0 - c1;
                    x = c1 * Math.Exp(r1 * t) + c2 * Math.Exp(r2 * t);
                }

                var px = (i / (double)samples) * 300.0;
                var py = baselineY - (initialDisplacement * x);

                if (i == 0)
                {
                    sb.Append(System.Globalization.CultureInfo.InvariantCulture, $"M {px:0.0} {py:0.0}");
                }
                else
                {
                    sb.Append(System.Globalization.CultureInfo.InvariantCulture, $" L {px:0.0} {py:0.0}");
                }
            }

            return sb.ToString();
        }
    }

    protected override void OnInitialized() => _state.ApplyPreset("classic");

    private void LogLeading(int index) => Log($"Leading · {PlaygroundState.LeadingNames[index]}");

    private void LogTrailing(int index) => Log($"Trailing · {PlaygroundState.TrailingNames[index]}");

    private void ApplyPreset(string id)
    {
        _state.ApplyPreset(id);
        StateHasChanged();
    }

    private void Set(Action mutate)
    {
        mutate();
        _state.MarkCustomPreset();
        StateHasChanged();
    }

    private void OnStateChanged(SwipeStateChange change)
    {
        _liveState = change.Side is { } side ? $"{change.State} · {side}" : change.State.ToString();
        Log($"State → {_liveState}");
    }

    private void Log(string message)
    {
        _log.Insert(0, $"{DateTime.Now:HH:mm:ss}  {message}");

        if (_log.Count > 20)
        {
            _log.RemoveAt(_log.Count - 1);
        }

        StateHasChanged();
    }
}
