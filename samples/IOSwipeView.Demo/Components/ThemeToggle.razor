@inject IJSRuntime JS

<button type="button"
        class="grid place-items-center w-9 h-9 rounded-full bg-fill-tertiary text-label hover:bg-fill-secondary transition-colors"
        title="@(_dark ? "Switch to light" : "Switch to dark")"
        aria-label="@(_dark ? "Switch to light appearance" : "Switch to dark appearance")"
        @onclick="ToggleAsync">
    @if (_dark)
    {
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
    }
    else
    {
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
    }
</button>

@code {
    private bool _dark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var current = await JS.InvokeAsync<string?>("document.documentElement.getAttribute", "data-theme");

        _dark = current is not null
            ? current == "dark"
            : await JS.InvokeAsync<bool>("eval", "matchMedia('(prefers-color-scheme: dark)').matches");

        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        _dark = !_dark;
        var theme = _dark ? "dark" : "light";

        await JS.InvokeVoidAsync("document.documentElement.setAttribute", "data-theme", theme);
        await JS.InvokeVoidAsync("localStorage.setItem", "ioswipe-theme", theme);
    }
}
