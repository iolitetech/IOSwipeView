<div class="mx-auto w-full max-w-[390px] @Class">
    <!-- Apple Hardware Outer Chassis with metallic edge & shadow -->
    <div class="relative rounded-ios-device bg-[#2c2c2e] dark:bg-[#1a1a1c] p-[9px] shadow-[0_25px_60px_-15px_rgba(0,0,0,0.7),0_0_0_1px_rgba(0,0,0,0.3)] dark:shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9),0_0_0_1px_rgba(255,255,255,0.15)] ring-1 ring-black/30 dark:ring-white/15 border border-white/10 dark:border-white/10">
        <!-- Inner Screen Viewport -->
        <div class="relative overflow-hidden rounded-[42px] bg-grouped border border-separator/30 flex flex-col h-[700px] max-h-[85vh]">
            <!-- Dynamic Island / Top Notch -->
            <div class="absolute top-0 inset-x-0 z-30 flex justify-center pointer-events-none">
                <div class="mt-2.5 h-[26px] w-[105px] rounded-full bg-black ring-1 ring-white/10 shadow-sm"></div>
            </div>

            <!-- Sticky Top iOS Navigation Bar -->
            <div class="material flex-shrink-0 sticky top-0 z-20 px-4 pt-11 pb-2 border-b border-separator/60">
                <div class="flex items-center justify-between mb-0.5">
                    @if (!string.IsNullOrWhiteSpace(BackLabel))
                    {
                        <div class="text-callout text-sys-blue font-normal">&lsaquo; @BackLabel</div>
                    }
                    else
                    {
                        <div></div>
                    }
                    @if (Trailing is not null)
                    {
                        <div>@Trailing</div>
                    }
                </div>
                <h2 class="text-largetitle text-label font-bold tracking-tight">@Title</h2>
            </div>

            <!-- Scrollable Viewport Body -->
            <div class="relative z-10 flex-1 overflow-y-auto overflow-x-hidden min-h-0">
                @ChildContent
            </div>

            <!-- Bottom Home Indicator -->
            <div class="flex-shrink-0 flex justify-center py-2 bg-grouped">
                <div class="h-[5px] w-[134px] rounded-full bg-label-tertiary/60"></div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? BackLabel { get; set; }
    [Parameter] public int MinHeight { get; set; } = 620;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Trailing { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
