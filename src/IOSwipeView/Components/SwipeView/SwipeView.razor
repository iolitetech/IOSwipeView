@namespace IOSwipeView
<div @ref="_root"
     class="@RootCssClass"
     style="@RootCssStyle"
     tabindex="0"
     role="region"
     aria-roledescription="swipe row"
     aria-expanded="@(OpenSide is not null ? "true" : "false")"
     @onkeydown="HandleKeyDownAsync"
     @attributes="AdditionalAttributes">

    @if (LeadingActions is not null)
    {
        <div class="ioswipe__actions ioswipe__actions--leading">
            <div class="ioswipe__strip">
                <CascadingValue Value="_leadingSlot" IsFixed="true">
                    @LeadingActions(_leadingContext)
                </CascadingValue>
            </div>
        </div>
    }

    @if (TrailingActions is not null)
    {
        <div class="ioswipe__actions ioswipe__actions--trailing">
            <div class="ioswipe__strip">
                <CascadingValue Value="_trailingSlot" IsFixed="true">
                    @TrailingActions(_trailingContext)
                </CascadingValue>
            </div>
        </div>
    }

    <div class="ioswipe__content">
        <Gesture @ref="_gesture"
                 Classes="ioswipe__surface"
                 Options="_gestureOptions"
                 OnPanStart="HandlePanStartAsync"
                 OnPanMove="HandlePanMoveAsync"
                 OnPanEnd="HandlePanEndAsync">
            @ChildContent
        </Gesture>
    </div>

    <span class="sr-only" aria-live="polite" aria-atomic="true">@AriaStatusText</span>
</div>
